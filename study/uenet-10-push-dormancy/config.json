        { "type": "raw_html", "content": "<div class='sim'>\n  <div class='sim-tabs'>\n    <button class='wtab ue10tab active' type='button' data-m='pull'>① Pull (기본)</button>\n    <button class='wtab ue10tab' type='button' data-m='push'>② Push Model</button>\n    <button class='wtab ue10tab' type='button' data-m='dormancy'>③ Dormancy</button>\n  </div>\n  <canvas id='ue10-canvas' role='img' aria-label='Push Model과 Dormancy 시뮬레이터. 액터x속성 격자를 매 틱 검사하는데, Pull은 전부, Push는 바뀐 것만, Dormancy는 휴면 액터를 통째로 건너뛴다.'></canvas>\n  <div class='sim-controls'>\n    <button id='ue10-play' type='button'>⏸ 일시정지</button>\n  </div>\n  <div class='sim-stats'>\n    <div class='sim-stat'><span class='sim-stat-num' id='ue10-checks'>0 / 32</span><span class='sim-stat-lbl'>틱당 검사</span></div>\n    <div class='sim-stat'><span class='sim-stat-num' id='ue10-saved'>0</span><span class='sim-stat-lbl'>누적 검사 절약</span></div>\n  </div>\n  <p class='sim-caption' id='ue10-caption'></p>\n</div>" }
